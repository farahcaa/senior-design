SPRING_PROFILES_ACTIVE=staging

SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUERURI=https://auth-staging.company.com/realms/app
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWKSETURI=http://keycloak-service/realms/app/protocol/openid-connect/certs

# Application Configuration
SERVER_PORT=8080
LOGGING_LEVEL_COM_COMPANY_APP_SERVICE=DEBUG
LOGGING_LEVEL_ROOT=DEBUG

#CORS config
APP_CORS_ALLOWED_ORIGINS=https://staging.company.com

# Stripe billing portal "Return to merchant" target (defaults to localhost otherwise)
STRIPE_BILLING_PORTAL_RETURN_URL=https://staging.company.com/account
# Structured JSON logs (Spring Boot 3.4+ native, ECS schema). MDC fields (requestId, userId
# from RequestLoggingFilter) ride along automatically, making logs queryable in a store like Loki.
# Not set in base/dev, so local dev keeps human-readable plain-text logs.
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# Tags every Sentry issue with its environment (staging).
SENTRY_ENVIRONMENT=staging

# Absolute origin of the SPA - email-change confirmation links point here.
APP_FRONTEND_BASE_URL=https://staging.company.com
