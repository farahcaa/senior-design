{
  "name": "company-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": "yakovliam",
  "scripts": {
    "generate": "rm -rf src/gen/ ; kubb generate",
    "dev": "bun run generate ; bunx --bun vite --host 0.0.0.0",
    "build": "bun run generate ; bunx --bun vite build",
    "build:staging": "bun run generate ; bunx --bun vite build --mode staging",
    "build:production": "bun run generate ; bunx --bun vite build --mode production",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "bunx --bun vite preview",
    "generate-bundle": "npx @redocly/cli bundle ./kubb/kubbconfig.yaml -o openapi.bundle.yaml",
    "test-server": "bun run generate-bundle ; npx @stoplight/prism-cli mock openapi.bundle.yaml --port 4010",
    "deploy": "bun run build && wrangler pages deploy",
    "deploy:staging": "bun run build:staging && wrangler pages deploy --project-name=company-frontend-staging --branch=staging",
    "deploy:production": "bun run build:production && wrangler pages deploy --project-name=company-frontend --branch=production"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.100.5",
    "axios": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.574.0",
    "oidc-client-ts": "^3.5.0",
    "posthog-js": "^1.396.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-intersection-observer": "^10.0.3",
    "react-oidc-context": "^3.3.1",
    "react-router": "^7.14.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@kubb/cli": "^4.37.4",
    "@kubb/core": "^4.37.4",
    "@kubb/plugin-oas": "^4.37.4",
    "@kubb/plugin-react-query": "^4.37.4",
    "@kubb/plugin-ts": "^4.37.4",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "ajv": "^8.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.3.1"
  }
}
