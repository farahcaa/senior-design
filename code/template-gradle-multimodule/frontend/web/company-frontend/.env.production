# Production environment — loaded by `vite build` (Vite's default mode is "production").
# These are all public, client-side values that ship in the JS bundle, so this
# file is intentionally committed (see the `!.env.production` rule in .gitignore).
VITE_APP_VERSION=web-1.0.1
VITE_AUTHORITY=https://auth.company.com/realms/app
VITE_CLIENT_ID=app-frontend
VITE_BACKEND_BASE_URL=https://api.company.com
# Stripe *publishable* key (safe to expose). MUST be the live key for production —
# replace the placeholder below before the first prod deploy.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_PROD_KEY
# PostHog product analytics. The phc_ key is a PUBLIC project key (safe to ship in the bundle,
# like the Stripe publishable key above). Host defaults to US cloud in code; no VITE_POSTHOG_HOST
# needed unless you move off US cloud. Leave empty to disable.
VITE_POSTHOG_KEY=
