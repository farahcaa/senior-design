<mxfile host="drawio"><diagram id="D0 Block Diagram" name="D0 Block Diagram"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="920"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="920" as="geometry"/></mxCell><mxCell id="n2" value="&lt;span style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Calorie-Based Meal Finder&lt;/b&gt; — D0 Block Diagram&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1560" height="36" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Goal:&lt;/b&gt; help people find fast-food meals and grocery items that fit a personal calorie target, with clear calorie counts and serving sizes.&lt;br&gt;&lt;b&gt;Basic input:&lt;/b&gt; a logged-in user&#x27;s calorie target (plus optional restaurant filter); nutrition data imported by a maintainer.&lt;br&gt;&lt;b&gt;Basic output:&lt;/b&gt; a ranked list of complete meals or grocery items at or below the target, each with calories and serving size." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1560" height="70" as="geometry"/></mxCell><mxCell id="n4" value="Debian VM — Docker Compose (single host, one container per box)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;dashPattern=12 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="260" y="150" width="1010" height="590" as="geometry"/></mxCell><mxCell id="n5" value="Backend API (one Spring Boot image)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#3a5a8c;" vertex="1" parent="1"><mxGeometry x="720" y="320" width="280" height="380" as="geometry"/></mxCell><mxCell id="n6" value="User&#x27;s web browser&lt;br&gt;&lt;i&gt;(customer or maintainer)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="15" y="490" width="125" height="70" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;E3 Cloudflare Tunnel&lt;/b&gt;&lt;br&gt;&lt;i&gt;TLS + routing at Cloudflare edge; cloudflared connector on the VM dials out (no open inbound ports)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 4;strokeWidth=2;fontColor=#333333;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="470" width="190" height="110" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;E1 Identity Provider&lt;/b&gt; — Keycloak&lt;br&gt;&lt;i&gt;self-hosted container, configured not built by us&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 4;strokeWidth=2;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="190" width="560" height="70" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;C1 Web Frontend&lt;/b&gt;&lt;br&gt;&lt;i&gt;Next.js · US-01–05&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="490" width="180" height="70" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;C3 User Profile API&lt;/b&gt;&lt;br&gt;&lt;i&gt;US-01 (A1), US-05&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="370" width="200" height="70" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;C2 Food Search API&lt;/b&gt;&lt;br&gt;&lt;i&gt;US-01, US-02&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="490" width="200" height="70" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;C4 Nutrition Data Importer&lt;/b&gt;&lt;br&gt;&lt;i&gt;US-03&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="610" width="200" height="70" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;C5 Database&lt;/b&gt;&lt;br&gt;PostgreSQL&lt;br&gt;&lt;i&gt;foods, meals, profiles, import log&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1090" y="455" width="150" height="140" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;E2 USDA FoodData Central API&lt;/b&gt;&lt;br&gt;&lt;i&gt;public grocery nutrition data&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 4;strokeWidth=2;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="790" width="200" height="80" as="geometry"/></mxCell><mxCell id="n15" value="I1" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="I2" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="I3" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.75;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1