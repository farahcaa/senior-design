=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1382" y="194" width="190" height="44" as="geometry"/></mxCell><mxCell id="n32" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 4;strokeWidth=2;fontColor=#333333;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1302" y="250" width="70" height="44" as="geometry"/></mxCell><mxCell id="n33" value="External system we depend on but do not build (E#)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1382" y="254" width="190" height="44" as="geometry"/></mxCell><mxCell id="n34" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1302" y="310" width="70" height="44" as="geometry"/></mxCell><mxCell id="n35" value="Data store whose schema we design" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1382" y="314" width="190" height="44" as="geometry"/></mxCell><mxCell id="n36" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1302" y="370" width="70" height="44" as="geometry"/></mxCell><mxCell id="n37" value="Actor / client device" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1382" y="374" width="190" height="44" as="geometry"/></mxCell><mxCell id="n38" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;dashPattern=12 6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1302" y="430" width="70" height="44" as="geometry"/></mxCell><mxCell id="n39" value="Deployment boundary (host machine)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1382" y="434" width="190" height="44" as="geometry"/></mxCell><mxCell id="n40" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#3a5a8c;" vertex="1" parent="1"><mxGeometry x="1302" y="490" width="70" height="44" as="geometry"/></mxCell><mxCell id="n41" value="Single container image holding several modules" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1382" y="494" width="190" height="44" as="geometry"/></mxCell><mxCell id="n42" value="I#" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1302" y="568" as="sourcePoint"/><mxPoint x="1372" y="568" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n43" value="Interface. Arrow points from the caller to the callee; the response returns on the same connection. ID matches the interface table." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1382" y="550" width="190" height="110" as="geometry"/></mxCell><mxCell id="n44" value="&lt;i&gt;Italic text in a box lists the user stories that component serves.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1302" y="670" width="270" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>