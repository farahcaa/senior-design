<mxfile host="drawio"><diagram id="D0 Data Flow" name="D0 Data Flow"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2060" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2060" height="960" as="geometry"/></mxCell><mxCell id="n2" value="&lt;span style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Calorie-Based Meal Finder&lt;/b&gt; — D0 Data-Flow Diagram&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="2020" height="36" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Goal:&lt;/b&gt; help people find fast-food meals and grocery items that fit a personal calorie target, with clear calorie counts and serving sizes.&lt;br&gt;&lt;b&gt;Basic input:&lt;/b&gt; a logged-in user&#x27;s calorie target (plus optional restaurant filter); nutrition data imported by a maintainer.&lt;br&gt;&lt;b&gt;Basic output:&lt;/b&gt; a ranked list of complete meals or grocery items at or below the target, each with calories and serving size." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="2020" height="70" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Flow A — Food search (US-01, UC-01).&lt;/b&gt; Timing budget ≤ 2 s from submit to rendered results (AC-01.1): P1 ≤ 150 ms · network ≤ 750 ms · P2–P4 ≤ 800 ms (database query ≤ 500 ms) · P5 ≤ 300 ms." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="1500" height="44" as="geometry"/></mxCell><mxCell id="n5" value="Customer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="130" height="60" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;P1&lt;/b&gt; Capture target&lt;br&gt;&lt;i&gt;C1 · ≤150 ms&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="250" width="160" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;P2&lt;/b&gt; Validate target&lt;br&gt;&lt;i&gt;C2&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="250" width="160" height="100" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;P3&lt;/b&gt; Query matching meals&lt;br&gt;&lt;i&gt;C2&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="250" width="160" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;P4&lt;/b&gt; Rank closest-first, limit 20&lt;br&gt;&lt;i&gt;C2&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="250" width="160" height="100" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;P5&lt;/b&gt; Render results&lt;br&gt;&lt;i&gt;C1 · ≤300 ms&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1490" y="250" width="160" height="100" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;D1&lt;/b&gt; Nutrition DB (C5)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="410" width="200" height="46" as="geometry"/></mxCell><mxCell id="n12" value="calorie target&lt;br&gt;(typed text)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="search request&lt;br&gt;(JSON + JWT, I5)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="validated query&lt;br&gt;(int 100–5000,&lt;br&gt;restaurant IDs)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="parameterized&lt;br&gt;SQL (I10)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=none;exitX=0.3;exitY=1;entryX=0.35;entryY=0;labelPosition=left;align=right;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="stored rows&lt;br&gt;(meals + item&lt;br&gt;calories)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=none;exitX=0.65;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="n11" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="candidate meals&lt;br&gt;(in-memory&lt;br&gt;records)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="ranked result list&lt;br&gt;(JSON, ≤ 20, I5)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="result list (rendered page: name, type, calories, serving size)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n10" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1570" y="490"/><mxPoint x="85" y="490"/></Array></mxGeometry></mxCell><mxCell id="n20" value="validation error (JSON 400: accepted range) — exception E2" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="222"/><mxPoint x="1570" y="222"/></Array></mxGeometry></mxCell><mxCell id="n21" value="&lt;b&gt;Flow B — Nutrition data import (US-03, UC-02).&lt;/b&gt; No requirement sets a timing budget; runs only when the maintainer starts it. Nothing is written until the maintainer confirms the change summary." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="1500" height="44" as="geometry"/></mxCell><mxCell id="n22" value="Maintainer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="140" height="60" as="geometry"/></mxCell><mxCell id="n23" value="Restaurant&#x27;s published nutrition facts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 4;strokeWidth=2;fontColor=#333333;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="870" width="140" height="60" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;E2&lt;/b&gt; USDA FoodData Central" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 4;strokeWidth=2;fontColor=#333333;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="610" width="170" height="56" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;P6&lt;/b&gt; Submit import&lt;br&gt;&lt;i&gt;C1&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="710" width="160" height="100" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;P7&lt;/b&gt; Validate rows&lt;br&gt;&lt;i&gt;C4&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="710" width="160" height="100" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;P8&lt;/b&gt; Compare with current data&lt;br&gt;&lt;i&gt;C4&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="710" width="160" height="100" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;P9&lt;/b&gt; Commit + recalculate meal totals&lt;br&gt;&lt;i&gt;C4&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="710" width="160" height="100" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;D1&lt;/b&gt; Nutrition DB (C5)" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1500" y="737" width="200" height="46" as="geometry"/></mxCell><mxCell id="n30" value="nutrition table&lt;br&gt;(PDF / web page)" style="html=1;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize