SPRING_HTTP_CONVERTERS_PREFERREDJSONMAPPER=JACKSON
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
# Time is UTC end-to-end. TZ pins the container/JVM default zone so any stray LocalDate/log is UTC;
# hibernate.jdbc.time_zone makes Hibernate read/write timestamps to Postgres in UTC regardless of
# host zone; write-dates-as-timestamps=false keeps Jackson emitting ISO-8601 instants (2026-…Z),
# not epoch numbers, to the frontend. Entities use java.time.Instant; columns are timestamptz.
TZ=UTC
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_TIME_ZONE=UTC
SPRING_JACKSON_SERIALIZATION_WRITE_DATES_AS_TIMESTAMPS=false
SPRING_LIQUIBASE_CHANGE_LOG=classpath:db/liquibase-changelog.xml
LOGGING_LEVEL_COM_COMPANY_APP=INFO
LOGGING_LEVEL_ROOT=INFO
# Actuator: expose health (+ liveness/readiness probe groups) for k8s probes
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
# Graceful shutdown: stop accepting new requests and drain in-flight ones before exit
SERVER_SHUTDOWN=graceful
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s
# DB connection pool. Sized above Spring's default of 10 because some request paths may hold a
# connection across a slow external call; a larger pool keeps normal DB work flowing while a
# burst of such requests is in flight. connection-timeout fails fast rather than queueing forever.
# Open-Session-In-View OFF: the Boot default (true) binds a JPA session to the WHOLE
# HTTP request - on request paths that await a slow external call, lazy access after the service tx
# can re-pin a connection during the wait. All serialization already
# happens from DTOs mapped inside the service layer, so nothing should lazy-load after the tx; if a
# spot was missed it fails LOUDLY as a LazyInitializationException (easy to catch in testing)
# instead of silently holding connections.
SPRING_JPA_OPEN_IN_VIEW=false
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=24
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=10000
# Sentry error tracking. DISABLED unless SENTRY_DSN is provided (staging/prod inject it from Vault
# via the sentry-secret ExternalSecret; dev leaves it unset -> Sentry is a no-op). These two are
# safe to set everywhere: send-default-pii=false so emails/tokens are never attached; a 10% trace
# sample keeps performance data light. SENTRY_ENVIRONMENT is set per overlay.
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.1
